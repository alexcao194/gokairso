# ============================================================
# Kairso self-host — sao chép thành .env rồi điền.
# ============================================================

# --- Chọn chế độ hạ tầng ---------------------------------------------------
# Mặc định: dùng PostgreSQL + Redis + MinIO gói sẵn trong bundle.
COMPOSE_FILE=docker-compose.yml:docker-compose.bundled.yml
# Tự lo DB/S3 bên ngoài? Đổi dòng trên thành:  COMPOSE_FILE=docker-compose.yml
# rồi điền DB_HOST/… và MINIO_ENDPOINT/… ở dưới trỏ tới dịch vụ của bạn.

# --- Image Docker Hub ------------------------------------------------------
KAIRSO_NS=your-dockerhub-namespace      # vd alexcao -> alexcao/kairso-web, alexcao/kairso-server
KAIRSO_TAG=latest

# --- Truy cập ---------------------------------------------------------------
PUBLIC_URL=http://localhost:8080        # URL người dùng mở (KHÔNG có / cuối)
PUBLIC_PORT=8080
MAX_UPLOAD_SIZE=200m                    # giới hạn dung lượng upload qua nginx
WS_URL_OVERRIDE=                        # rỗng = WebSocket same-origin (/ws). Chỉ đặt khi tách host.

# --- Bí mật (ĐỔI hết trước khi chạy thật) ----------------------------------
JWT_SECRET=change-me-long-random
APP_TOKEN_SECRET=change-me-long-random  # dùng chung web (APP_SIGNATURE_SECRET) + server
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=168h

# --- PostgreSQL (tương thích PostgreSQL 15+) -------------------------------
# Bundled: để nguyên DB_HOST=postgres. Dùng Postgres ngoài: đổi DB_HOST/PORT/SSLMODE.
DB_HOST=postgres
DB_PORT=5432
DB_USER=kairso
DB_PASSWORD=change-me
DB_NAME=kairso
DB_SSLMODE=disable                      # Postgres ngoài có TLS: require / verify-full

# --- Object storage (tương thích S3: MinIO, AWS S3, R2, B2, Wasabi…) -------
# Bundled MinIO: để nguyên. S3 ngoài: đổi MINIO_ENDPOINT (host:port, không có scheme),
# bật MINIO_USE_SSL=true, và đặt MINIO_PUBLIC_URL = URL public của bucket/CDN.
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=kairso
MINIO_SECRET_KEY=change-me-min-8-chars
MINIO_BUCKET=kairso
MINIO_USE_SSL=false
# MINIO_PUBLIC_URL=                      # bỏ trống = <PUBLIC_URL>/cdn (bundled). S3 ngoài: điền URL S3/CDN.

# --- Redis (bundled; hoặc trỏ Redis ngoài) ---------------------------------
REDIS_HOST=redis
REDIS_PORT=6379

# --- Firebase (BẮT BUỘC để đăng nhập) --------------------------------------
# Tạo Firebase project của bạn, bật Authentication (Google/Email).
# Client config (Project settings > Your apps > SDK config):
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
# Service account (Project settings > Service accounts > Generate new private key):
#   lưu JSON cạnh file này tên  firebase-credentials.json
